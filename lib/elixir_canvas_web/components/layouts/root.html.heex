<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="A local-file-first spatial thinking canvas built with Elixir, Phoenix LiveView, and Hakushi. The JSON file is the document, not an export from a database."
    />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Canvas" suffix=" · Elixir Canvas">{assigns[:page_title]}</.live_title>
    <link rel="icon" type="image/svg+xml" href={~p"/images/logo.svg"} />
    <link rel="alternate icon" href={~p"/favicon.ico"} />
    <link
      rel="preload"
      href={~p"/fonts/neo-acid/mona-sans-latin-400-normal.woff2"}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={~p"/fonts/neo-acid/monaspace-neon-latin-700-normal.woff2"}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
